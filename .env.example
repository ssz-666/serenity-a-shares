# Optional LLM providers. Keep real values in Vercel/hosting env vars, never in public code.
MODEL_PROVIDER=mock
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=

# Main analysis API. Default to DeepSeek so both heavy and cheap tasks can use a domestic API.
MAIN_MODEL_PROVIDER=domestic-lite
CHATGPT_API_KEY=
CHATGPT_BASE_URL=https://api.openai.com/v1
CHATGPT_MODEL=

# DeepSeek / domestic OpenAI-compatible endpoint.
LITE_MODEL_PROVIDER=domestic-lite
DOMESTIC_API_KEY=
DOMESTIC_BASE_URL=https://api.deepseek.com
DOMESTIC_MODEL=deepseek-v4-pro
LITE_MODEL_API_KEY=
LITE_MODEL_BASE_URL=
LITE_MODEL_NAME=

# OpenAI-compatible fallback examples:
# MODEL_PROVIDER=openai-compatible
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4.1

# Optional market data providers.
DATA_PROVIDER=mock
TUSHARE_TOKEN=
AKSHARE_BASE_URL=
CUSTOM_DATA_BASE_URL=

# Optional simple access protection for backend mode.
SITE_PASSWORD=
ALLOWED_ORIGIN=

# Local dev server.
PORT=3000
